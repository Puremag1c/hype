#!/bin/bash
# hype CLI — управление многоагентной системой разработки
#
# Использование:
#   hype init      Инициализация проекта + запуск HYPE
#   hype start     Запуск HYPE (если уже инициализирован)
#   hype status    Статус проекта
#   hype update    Обновление hype

set -euo pipefail

HYPE_HOME="${HYPE_HOME:-$HOME/.hype}"
VERSION=$(cat "$HYPE_HOME/VERSION" 2>/dev/null || echo "dev")

# Source common functions (milestone management, etc.)
# shellcheck source=../core/scripts/common.sh
source "$HYPE_HOME/core/scripts/common.sh"

# === Colors ===

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# HYPE brand colors (neon pink gradient)
HYPE_H='\033[38;2;255;0;102m'      # #ff0066 Neon Pink
HYPE_Y='\033[38;2;255;51;153m'     # #ff3399 Pink
HYPE_P='\033[38;2;255;102;204m'    # #ff66cc Light Pink
HYPE_E='\033[38;2;204;255;0m'      # #ccff00 Lime
BOLD='\033[1m'

# Colorize "HYPE" in text
colorize_hype() {
    local text="$1"
    if [ -t 1 ]; then
        echo "$text" | sed "s/HYPE/${HYPE_H}H${HYPE_Y}Y${HYPE_P}P${HYPE_E}E${NC}/g"
    else
        echo "$text"
    fi
}

# Print HYPE ASCII logo with fire gradient
print_hype_logo() {
    [ ! -t 1 ] && return  # Skip if not terminal

    echo ""
    echo -e "  ${HYPE_H}██╗  ██╗${NC} ${HYPE_Y}██╗   ██╗${NC} ${HYPE_P}██████╗ ${NC} ${HYPE_E}███████╗${NC}"
    echo -e "  ${HYPE_H}██║  ██║${NC} ${HYPE_Y}╚██╗ ██╔╝${NC} ${HYPE_P}██╔══██╗${NC} ${HYPE_E}██╔════╝${NC}"
    echo -e "  ${HYPE_H}███████║${NC} ${HYPE_Y} ╚████╔╝ ${NC} ${HYPE_P}██████╔╝${NC} ${HYPE_E}█████╗  ${NC}"
    echo -e "  ${HYPE_H}██╔══██║${NC} ${HYPE_Y}  ╚██╔╝  ${NC} ${HYPE_P}██╔═══╝ ${NC} ${HYPE_E}██╔══╝  ${NC}"
    echo -e "  ${HYPE_H}██║  ██║${NC} ${HYPE_Y}   ██║   ${NC} ${HYPE_P}██║     ${NC} ${HYPE_E}███████╗${NC}"
    echo -e "  ${HYPE_H}╚═╝  ╚═╝${NC} ${HYPE_Y}   ╚═╝   ${NC} ${HYPE_P}╚═╝     ${NC} ${HYPE_E}╚══════╝${NC}"
    echo ""
}

info()    { echo -e "${BLUE}▸${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn()    { echo -e "${YELLOW}!${NC} $1"; }
error()   { echo -e "${RED}✗${NC} $1" >&2; }

# === Dependency check ===

DEPS_CONF="$HYPE_HOME/deps.conf"

# Extract semver from command output
# Usage: get_dep_version "bd version"
get_dep_version() {
    local version_extract="$1"
    eval "$version_extract" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1
}

# Compare two semver strings
# Returns: -1 (v1 < v2), 0 (v1 == v2), 1 (v1 > v2)
# Usage: version_compare "1.2.3" "1.3.0"
version_compare() {
    local v1="$1" v2="$2"
    if [[ "$v1" == "$v2" ]]; then
        echo 0
        return
    fi
    local sorted
    sorted=$(printf '%s\n%s\n' "$v1" "$v2" | sort -V | head -1)
    if [[ "$sorted" == "$v1" ]]; then
        echo -1
    else
        echo 1
    fi
}

# Check dependency versions from deps.conf
# Blocks on missing required deps, warns on version mismatch
check_dep_versions() {
    [[ -f "$DEPS_CONF" ]] || { check_deps_fallback; return; }

    local missing=()
    local has_warnings=false

    while IFS='|' read -r name cmd version_extract min_version max_version brew_pkg required; do
        # Skip comments and empty lines
        [[ "$name" =~ ^#.*$ || -z "$name" ]] && continue

        # Check if command exists
        if ! command -v "$cmd" &>/dev/null; then
            if [[ "$required" == "true" ]]; then
                missing+=("$name ($cmd)")
            fi
            continue
        fi

        # Skip version check if no min/max specified
        [[ -z "$min_version" && -z "$max_version" ]] && continue

        local current_version
        current_version=$(get_dep_version "$version_extract")
        [[ -z "$current_version" ]] && continue

        # Check minimum version
        if [[ -n "$min_version" ]]; then
            local cmp
            cmp=$(version_compare "$current_version" "$min_version")
            if [[ "$cmp" == "-1" ]]; then
                warn "$name $current_version is outdated, need ≥$min_version. Run: hype update"
                has_warnings=true
            fi
        fi

        # Check maximum version
        if [[ -n "$max_version" ]]; then
            local cmp
            cmp=$(version_compare "$current_version" "$max_version")
            if [[ "$cmp" == "1" ]]; then
                warn "$name $current_version is newer than HYPE $VERSION supports (max $max_version). Possible issues"
                has_warnings=true
            fi
        fi
    done < "$DEPS_CONF"

    if [[ ${#missing[@]} -gt 0 ]]; then
        error "Missing dependencies: ${missing[*]}"
        echo ""
        echo "Install with:"
        echo "  curl -fsSL https://raw.githubusercontent.com/Puremag1c/hype/main/install.sh | bash"
        exit 1
    fi
}

# Fallback if deps.conf missing (shouldn't happen after update)
check_deps_fallback() {
    local missing=()
    command -v bd &>/dev/null || missing+=("beads (bd)")
    command -v claude &>/dev/null || missing+=("claude-code")
    command -v gh &>/dev/null || missing+=("gh")
    command -v jq &>/dev/null || missing+=("jq")

    if [[ ${#missing[@]} -gt 0 ]]; then
        error "Missing dependencies: ${missing[*]}"
        echo ""
        echo "Install with:"
        echo "  curl -fsSL https://raw.githubusercontent.com/Puremag1c/hype/main/install.sh | bash"
        exit 1
    fi
}

# Alias for backward compatibility (called from cmd_init and cmd_start)
check_deps() {
    check_dep_versions
}

# === GitHub Setup ===

setup_github() {
    # Check if gh is authenticated
    if ! gh auth status &>/dev/null; then
        echo ""
        echo "GitHub позволяет хранить код в облаке и синхронизировать между устройствами."
        echo ""
        read -p "У вас есть аккаунт GitHub? (y/n) " -n 1 -r
        echo ""

        if [[ $REPLY =~ ^[Yy]$ ]]; then
            info "Запускаем авторизацию GitHub..."
            echo ""
            if gh auth login; then
                success "GitHub авторизация успешна"
            else
                warn "Авторизация не удалась, работаем локально"
                return
            fi
        else
            info "Работаем локально (без GitHub)"
            return
        fi
    fi

    # Check if remote exists
    if ! git remote get-url origin &>/dev/null; then
        echo ""
        read -p "Создать GitHub репозиторий для этого проекта? (y/n) " -n 1 -r
        echo ""

        if [[ $REPLY =~ ^[Yy]$ ]]; then
            local repo_name=$(basename "$(pwd)")
            info "Создаём приватный репозиторий $repo_name..."

            if gh repo create "$repo_name" --private --source=. --remote=origin; then
                success "GitHub репозиторий создан"
            else
                warn "Не удалось создать репозиторий, работаем локально"
            fi
        else
            info "Работаем локально (без GitHub)"
        fi
    else
        success "GitHub remote настроен"
    fi
}

# === Gitleaks Auto-Setup ===

setup_gitleaks() {
    # Skip if no GitHub remote (local projects don't need this)
    if ! git remote get-url origin &>/dev/null; then
        return
    fi

    # Try to install gitleaks if not present
    if ! command -v gitleaks &>/dev/null; then
        # Try brew (macOS/Linux with Homebrew)
        if command -v brew &>/dev/null; then
            brew install gitleaks &>/dev/null && success "gitleaks installed"
        # Try apt (Debian/Ubuntu)
        elif command -v apt &>/dev/null; then
            sudo apt install -y gitleaks &>/dev/null 2>&1 && success "gitleaks installed"
        fi
        # If neither works, silently skip
    fi

    # Setup pre-commit hook if gitleaks is available
    if command -v gitleaks &>/dev/null; then
        local hook_file=".git/hooks/pre-commit"

        # Create hooks dir if needed
        mkdir -p .git/hooks

        # Add gitleaks to pre-commit (or create new hook)
        if [[ -f "$hook_file" ]]; then
            if ! grep -q "gitleaks" "$hook_file"; then
                # Append to existing hook
                echo "" >> "$hook_file"
                echo "# Gitleaks - prevent secret leaks" >> "$hook_file"
                echo "gitleaks protect --staged --verbose" >> "$hook_file"
                success "gitleaks hook added"
            fi
        else
            # Create new hook
            cat > "$hook_file" << 'HOOK'
#!/bin/bash
# Gitleaks - prevent secret leaks
gitleaks protect --staged --verbose
HOOK
            chmod +x "$hook_file"
            success "gitleaks hook created"
        fi
    fi
}

# === MCP Servers Setup ===

setup_mcp() {
    # Skip if .mcp.json already exists
    if [[ -f ".mcp.json" ]]; then
        success "MCP servers configured (.mcp.json exists)"
        return
    fi

    info "Configuring MCP servers..."

    # Start with empty mcpServers object
    local mcp_config='{"mcpServers":{}}'

    # 1. Playwright - always add (no auth required)
    mcp_config=$(echo "$mcp_config" | jq '.mcpServers.playwright = {
        "command": "npx",
        "args": ["-y", "@playwright/mcp@latest"]
    }')
    success "Added Playwright MCP (browser automation)"

    # 2. GitHub - add if gh is authenticated
    if gh auth status &>/dev/null; then
        # Use gh auth token dynamically via command substitution
        # Token is NOT stored in file - fetched at runtime
        mcp_config=$(echo "$mcp_config" | jq '.mcpServers.github = {
            "command": "sh",
            "args": ["-c", "GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token) npx -y @modelcontextprotocol/server-github"]
        }')
        success "Added GitHub MCP (repo management)"
    else
        info "GitHub MCP skipped (gh not authenticated)"
    fi

    # 3. PostgreSQL - add template with placeholder
    mcp_config=$(echo "$mcp_config" | jq '.mcpServers["postgres"] = {
        "command": "npx",
        "args": ["-y", "@bytebase/dbhub", "--dsn", "env:DATABASE_URL"],
        "env": {
            "DATABASE_URL": "postgresql://user:password@localhost:5432/mydb"
        }
    }')

    # 4. Supabase - add template with placeholder
    mcp_config=$(echo "$mcp_config" | jq '.mcpServers["supabase"] = {
        "command": "npx",
        "args": ["-y", "@supabase/mcp-server-supabase@latest", "--access-token", "env:SUPABASE_ACCESS_TOKEN"],
        "env": {
            "SUPABASE_ACCESS_TOKEN": "your-supabase-access-token"
        }
    }')

    # Write .mcp.json
    echo "$mcp_config" | jq '.' > .mcp.json

    success "Created .mcp.json"
    echo ""
    info "MCP servers configured:"
    echo "  - playwright: Ready to use"
    if gh auth status &>/dev/null; then
        echo "  - github: Ready to use"
    fi
    echo "  - postgres: Edit DATABASE_URL in .mcp.json"
    echo "  - supabase: Edit SUPABASE_ACCESS_TOKEN in .mcp.json"
}

# === Project Type Detection ===

detect_project_type() {
    # Check for existing SPEC.md
    if [[ -f "SPEC.md" ]]; then
        echo "has_spec"
        return
    fi

    # Check for code files
    local has_code=false

    # Common code file patterns
    for pattern in "*.ts" "*.tsx" "*.js" "*.jsx" "*.py" "*.ex" "*.exs" "*.go" "*.rs" "*.java" "*.rb"; do
        if compgen -G "$pattern" > /dev/null 2>&1 || compgen -G "src/$pattern" > /dev/null 2>&1; then
            has_code=true
            break
        fi
    done

    # Check for project manifest files (indicates existing project)
    if [[ -f "package.json" ]] || [[ -f "mix.exs" ]] || [[ -f "go.mod" ]] || \
       [[ -f "Cargo.toml" ]] || [[ -f "pyproject.toml" ]] || [[ -f "requirements.txt" ]]; then
        has_code=true
    fi

    if [[ "$has_code" = true ]]; then
        echo "existing"
    else
        echo "empty"
    fi
}

# === Init ===

cmd_init() {
    print_hype_logo
    info "Initializing hype in $(pwd)"

    check_deps

    # Beads health check (only if already initialized — fresh projects get bd init below)
    if [[ -d ".beads" ]]; then
        # Clean stale Dolt runtime files that block server start
        rm -f .beads/dolt-server.lock .beads/dolt-server.pid .beads/dolt-server.port 2>/dev/null || true
        ensure_dolt_server
        if ! bd list --limit 1 &>/dev/null; then
            # Retry once after cleaning locks
            sleep 2
            ensure_dolt_server
            if ! bd list --limit 1 &>/dev/null; then
                error "Beads backend not responding. Run 'bd doctor --fix'"
                exit 1
            fi
        fi
    fi

    # Detect project type BEFORE init
    local project_type=$(detect_project_type)

    # Git
    if [[ ! -d ".git" ]]; then
        info "Initializing git..."
        git init -q
        success "git init"
    else
        success "git already initialized"
    fi

    # GitHub setup (interactive)
    setup_github

    # Gitleaks auto-setup (only if GitHub configured)
    setup_gitleaks

    # MCP servers setup
    setup_mcp

    # Beads
    if [[ ! -d ".beads" ]]; then
        info "Initializing beads..."
        bd init
        success "bd init"
    else
        success "beads already initialized"
    fi

    # .hype/config.sh
    mkdir -p .hype

    # Save hype version for upgrade detection
    echo "$VERSION" > .hype/version
    success "Saved hype version ($VERSION)"

    if [[ ! -f ".hype/config.sh" ]]; then
        info "Creating config..."
        cp "$HYPE_HOME/templates/config.template.sh" .hype/config.sh
        success "Created .hype/config.sh"
    else
        success ".hype/config.sh exists"
    fi

    # Symlinks
    mkdir -p .claude

    # Link .claude/agents (handle existing directory)
    if [[ -L ".claude/agents" ]]; then
        success ".claude/agents already linked"
    elif [[ -d ".claude/agents" ]]; then
        warn ".claude/agents is a directory, renaming to .claude/agents.backup"
        mv .claude/agents .claude/agents.backup
        ln -sf "$HYPE_HOME/core/agents" .claude/agents
        success "Linked .claude/agents (old dir backed up)"
    else
        ln -sf "$HYPE_HOME/core/agents" .claude/agents
        success "Linked .claude/agents"
    fi

    # Link .claude/commands (handle existing directory)
    if [[ -L ".claude/commands" ]]; then
        success ".claude/commands already linked"
    elif [[ -d ".claude/commands" ]]; then
        warn ".claude/commands is a directory, renaming to .claude/commands.backup"
        mv .claude/commands .claude/commands.backup
        ln -sf "$HYPE_HOME/core/commands" .claude/commands
        success "Linked .claude/commands (old dir backed up)"
    else
        ln -sf "$HYPE_HOME/core/commands" .claude/commands
        success "Linked .claude/commands"
    fi

    # Link scripts/ (handle existing directory - common in projects)
    if [[ -L "scripts" ]]; then
        success "scripts/ already linked"
    elif [[ -d "scripts" ]]; then
        warn "scripts/ directory exists, renaming to project-scripts/"
        mv scripts project-scripts
        ln -sf "$HYPE_HOME/core/scripts" scripts
        success "Linked scripts/ (old dir renamed to project-scripts/)"
        info "Your original scripts are in project-scripts/"
    else
        ln -sf "$HYPE_HOME/core/scripts" scripts
        success "Linked scripts/"
    fi

    # .claude/settings.json
    if [[ ! -f ".claude/settings.json" ]]; then
        info "Creating Claude Code settings..."
        cat > .claude/settings.json << 'EOF'
{
  "spinnerTipsEnabled": false,
  "permissions": {
    "allow": [
      "Bash(bd *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(./scripts/*)"
    ],
    "deny": []
  }
}
EOF
        success "Created .claude/settings.json"
    else
        success ".claude/settings.json exists"
    fi

    # .gitignore
    if [[ -f ".gitignore" ]]; then
        if ! grep -q "# Hype" .gitignore 2>/dev/null; then
            info "Updating .gitignore..."
            cat >> .gitignore << 'EOF'

# Hype
.hype/
.hype-worktrees/
.claude/agents
.claude/commands
scripts
project-scripts/
logs/
stats/
PROJECT_CONTEXT.md
SPEC.md
SPEC.draft.md
SPEC.prev.md
SPEC_REPORT.prev.md
.mcp.json
EOF
            success "Updated .gitignore"
        fi
    else
        info "Creating .gitignore..."
        cat > .gitignore << 'EOF'
# Hype
.hype/
.hype-worktrees/
.claude/agents
.claude/commands
scripts
project-scripts/
logs/
stats/
PROJECT_CONTEXT.md
SPEC.md
SPEC.draft.md
SPEC.prev.md
SPEC_REPORT.prev.md
.mcp.json
EOF
        success "Created .gitignore"
    fi

    # Handle project type
    echo ""
    case "$project_type" in
        has_spec)
            success "Found SPEC.md - will skip to PLANNING phase"
            ;;
        existing)
            info "Detected existing project, analyzing..."
            if retry_command 3 "$HYPE_HOME/core/scripts/analyze-project.sh"; then
                success "Created PROJECT_CONTEXT.md"
            else
                warn "Analysis failed, creating minimal context..."
                create_minimal_project_context "$(pwd)"
                success "Created minimal PROJECT_CONTEXT.md (fallback)"
            fi
            ;;
        empty)
            info "Empty project - Manager will gather requirements"
            ;;
    esac

    # Save project type for HYPE
    echo "$project_type" > .hype/project_type

    # Ensure all entries present (single source of truth for gitignore entries)
    update_gitignore
    update_beads_gitignore
    commit_gitignore_changes

    echo ""
    success "Project initialized!"
    echo ""
    info "Starting HYPE..."
    echo ""

    exec "$HYPE_HOME/core/scripts/hype.sh"
}

# === Start ===

cmd_start() {
    if [[ ! -d ".hype" ]]; then
        error "Not a hype project. Run 'hype init' first."
        exit 1
    fi

    print_hype_logo
    check_deps

    # Beads health check — ensure persistent Dolt server
    rm -f .beads/dolt-server.lock .beads/dolt-server.pid .beads/dolt-server.port 2>/dev/null || true
    ensure_dolt_server
    if ! bd list --limit 1 &>/dev/null; then
        sleep 2
        ensure_dolt_server
        if ! bd list --limit 1 &>/dev/null; then
            error "Beads backend not responding. Run 'bd doctor --fix'"
            exit 1
        fi
    fi

    # If DONE, inform user about cleanup
    local current_phase phase_json
    phase_json=$(./scripts/detect-phase.sh 2>/dev/null || echo '{"phase":"UNKNOWN"}')
    current_phase=$(echo "$phase_json" | jq -r '.phase // "UNKNOWN"' 2>/dev/null || echo "UNKNOWN")
    if [[ "$current_phase" == "DONE" ]]; then
        warn "Previous iteration complete. Run 'hype clear' before starting new iteration."
        echo ""
        echo "Or continue to review results (logs preserved)."
        echo ""
        read -p "Continue anyway? (y/N) " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi

    info "Starting HYPE..."
    exec "$HYPE_HOME/core/scripts/hype.sh"
}

# === Status ===

cmd_status() {
    if [[ ! -d ".hype" ]]; then
        error "Not a hype project."
        exit 1
    fi

    echo -e "${HYPE_H}H${HYPE_Y}Y${HYPE_P}P${HYPE_E}E${NC} $VERSION"
    echo ""

    # HYPE status
    local lock_file=".hype/hype.lock"
    if [[ -f "$lock_file" ]]; then
        local pid=$(cat "$lock_file" 2>/dev/null || echo "0")
        if kill -0 "$pid" 2>/dev/null; then
            success "HYPE running (PID $pid)"
        else
            warn "Stale lock file (PID $pid not found)"
        fi
    else
        info "HYPE not running"
    fi

    echo ""

    # Active coders and pending reviews
    if command -v bd &>/dev/null && [[ -d ".beads" ]]; then
        local in_progress
        in_progress=$(bd list --status=in_progress --json --limit 0 2>/dev/null || echo "[]")

        # Active coders (have coder label)
        local coders
        coders=$(echo "$in_progress" | jq -r '.[] | select(.labels | index("coder")) | "\(.id)|\(.title)|\(.updated_at)"' 2>/dev/null || true)

        if [[ -n "$coders" ]]; then
            echo "Active coders:"
            local now_epoch
            now_epoch=$(date +%s)
            while IFS='|' read -r task_id title updated_at; do
                [[ -z "$task_id" ]] && continue
                # Calculate duration
                local task_epoch duration_s duration_str
                task_epoch=$(parse_utc_epoch "$updated_at")
                duration_s=$((now_epoch - task_epoch))
                if [[ $duration_s -ge 60 ]]; then
                    duration_str="$((duration_s / 60))m $((duration_s % 60))s"
                else
                    duration_str="${duration_s}s"
                fi
                # Truncate title
                title="${title:0:35}"
                printf "  %-12s %-37s %8s  logs/coder-%s.log\n" "$task_id" "\"$title\"" "$duration_str" "$task_id"
            done <<< "$coders"
            echo ""
        fi

        # Pending reviews (have needs-review label, no coder label)
        local reviews
        reviews=$(echo "$in_progress" | jq -r '.[] | select((.labels // [] | index("needs-review")) and ((.labels // [] | index("coder")) | not)) | "\(.id)|\(.title)"' 2>/dev/null || true)

        if [[ -n "$reviews" ]]; then
            echo "Pending reviews:"
            while IFS='|' read -r task_id title; do
                [[ -z "$task_id" ]] && continue
                title="${title:0:40}"
                printf "  %-12s %-42s waiting for review\n" "$task_id" "\"$title\""
            done <<< "$reviews"
            echo ""
        fi

        # Active reviews (reviewing label)
        local reviewing
        reviewing=$(echo "$in_progress" | jq -r '.[] | select((.labels // []) | index("reviewing")) | "\(.id)|\(.title)"' 2>/dev/null || true)

        if [[ -n "$reviewing" ]]; then
            echo "Under review:"
            while IFS='|' read -r task_id title; do
                [[ -z "$task_id" ]] && continue
                title="${title:0:40}"
                printf "  %-12s %-42s reviewing\n" "$task_id" "\"$title\""
            done <<< "$reviewing"
            echo ""
        fi

        # Approved (waiting for merge)
        local approved
        approved=$(echo "$in_progress" | jq -r '.[] | select((.labels // []) | index("approved")) | "\(.id)|\(.title)"' 2>/dev/null || true)

        if [[ -n "$approved" ]]; then
            echo "Approved (merge queue):"
            while IFS='|' read -r task_id title; do
                [[ -z "$task_id" ]] && continue
                title="${title:0:40}"
                printf "  %-12s %-42s merging\n" "$task_id" "\"$title\""
            done <<< "$approved"
            echo ""
        fi

        # Beads stats
        bd stats 2>/dev/null || true
    fi
}

# === Update ===

# Update/check dependencies from deps.conf
update_dependencies() {
    [[ -f "$DEPS_CONF" ]] || return 0

    info "Checking dependencies..."

    while IFS='|' read -r name cmd version_extract min_version max_version brew_pkg required; do
        # Skip comments and empty lines
        [[ "$name" =~ ^#.*$ || -z "$name" ]] && continue

        # Not installed — skip (install is install.sh's job)
        if ! command -v "$cmd" &>/dev/null; then
            [[ "$required" == "true" ]] && warn "$name not installed"
            continue
        fi

        # No version range — presence is enough
        [[ -z "$min_version" && -z "$max_version" ]] && continue

        local current_version
        current_version=$(get_dep_version "$version_extract")
        [[ -z "$current_version" ]] && continue

        # Check if below minimum
        if [[ -n "$min_version" ]]; then
            local cmp
            cmp=$(version_compare "$current_version" "$min_version")
            if [[ "$cmp" == "-1" ]]; then
                # claude uses its own updater (not brew)
                if [[ "$cmd" == "claude" ]]; then
                    info "Upgrading claude $current_version → ≥$min_version..."
                    local claude_bin
                    claude_bin="$(command -v claude 2>/dev/null)"
                    if [[ -n "$claude_bin" ]] && [[ "$(stat -f '%Su' "$claude_bin" 2>/dev/null || stat -c '%U' "$claude_bin" 2>/dev/null)" == "root" ]]; then
                        sudo claude update || true
                    else
                        claude update || true
                    fi
                    hash -r
                elif command -v brew &>/dev/null && [[ -n "$brew_pkg" ]]; then
                    info "Upgrading $name $current_version → ≥$min_version..."
                    brew upgrade "$brew_pkg" 2>/dev/null || true
                else
                    warn "$name $current_version is below minimum $min_version"
                    continue
                fi
                # Re-check after upgrade
                local new_version
                new_version=$(get_dep_version "$version_extract")
                if [[ -n "$new_version" ]]; then
                    local new_cmp
                    new_cmp=$(version_compare "$new_version" "$min_version")
                    if [[ "$new_cmp" != "-1" ]]; then
                        success "$name $new_version"
                    else
                        warn "$name $new_version still below minimum $min_version"
                    fi
                fi
                continue
            fi
        fi

        # Check if above maximum
        if [[ -n "$max_version" ]]; then
            local cmp
            cmp=$(version_compare "$current_version" "$max_version")
            if [[ "$cmp" == "1" ]]; then
                warn "$name $current_version is newer than supported (max $max_version)"
                continue
            fi
        fi

        success "$name $current_version"
    done < "$DEPS_CONF"
}

cmd_update() {
    local no_deps=false
    local deps_only=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-deps) no_deps=true; shift ;;
            --deps-only) deps_only=true; shift ;;
            --no-self) shift ;;  # skip git pull (already done)
            *) shift ;;
        esac
    done

    if [[ "$deps_only" == true ]]; then
        update_dependencies
        return
    fi

    info "Updating hype..."

    if [[ -d "$HYPE_HOME/.git" ]]; then
        cd "$HYPE_HOME"
        git fetch origin
        # Handle force-pushed commits (diverged history)
        if ! git pull --ff-only 2>/dev/null; then
            warn "History diverged, resetting to origin/main..."
            git reset --hard origin/main
        fi
        VERSION=$(cat VERSION)
        success "Updated to $VERSION"
    else
        warn "Not a git installation, re-run install.sh"
    fi

    if [[ "$no_deps" == false ]]; then
        # exec new binary so update_dependencies runs from updated code
        exec "$HYPE_HOME/bin/hype" update --no-self --deps-only
    fi
}

# === Upgrade ===

cmd_upgrade() {
    local upgrade_all=false
    local force=false

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) upgrade_all=true; shift ;;
            --force|-f) force=true; shift ;;
            *) shift ;;
        esac
    done

    if [[ "$upgrade_all" = true ]]; then
        upgrade_all_projects "$force"
        return
    fi

    # Single project upgrade
    if [[ ! -d ".hype" ]]; then
        error "Not a hype project. Run 'hype init' first."
        exit 1
    fi

    upgrade_project "$(pwd)" "$force"
}

upgrade_project() {
    local project_dir="$1"
    local force="${2:-false}"

    cd "$project_dir"

    local project_version=$(cat .hype/version 2>/dev/null || echo "unknown")

    if [[ "$project_version" = "$VERSION" ]] && [[ "$force" != "true" ]]; then
        success "Project already at version $VERSION"
        return
    fi

    info "Upgrading $(basename "$project_dir"): $project_version → $VERSION"

    # Run migrations if available
    run_migrations "$project_version" "$VERSION"

    # Update symlinks (always recreate - handles missing, broken, or directory cases)
    mkdir -p .claude

    # .claude/agents
    if [[ -d ".claude/agents" && ! -L ".claude/agents" ]]; then
        warn ".claude/agents is a directory, renaming to .claude/agents.backup"
        mv .claude/agents ".claude/agents.backup.$(date +%s)"
    fi
    rm -f .claude/agents 2>/dev/null || true
    ln -sf "$HYPE_HOME/core/agents" .claude/agents
    success "Updated .claude/agents symlink"

    # .claude/commands
    if [[ -d ".claude/commands" && ! -L ".claude/commands" ]]; then
        warn ".claude/commands is a directory, renaming to .claude/commands.backup"
        mv .claude/commands ".claude/commands.backup.$(date +%s)"
    fi
    rm -f .claude/commands 2>/dev/null || true
    ln -sf "$HYPE_HOME/core/commands" .claude/commands
    success "Updated .claude/commands symlink"

    # scripts/
    if [[ -d "scripts" && ! -L "scripts" ]]; then
        warn "scripts/ is a directory, renaming to project-scripts/"
        mv scripts "project-scripts"
    fi
    rm -f scripts 2>/dev/null || true
    ln -sf "$HYPE_HOME/core/scripts" scripts
    success "Updated scripts/ symlink"

    # Update config.sh (merge strategy: add new variables, keep user values)
    if [[ -f ".hype/config.sh" ]]; then
        local template="$HYPE_HOME/templates/config.template.sh"
        if [[ -f "$template" ]]; then
            merge_config ".hype/config.sh" "$template"
        fi
    fi

    # Update .gitignore entries
    update_gitignore
    update_beads_gitignore
    commit_gitignore_changes

    # Ensure spinnerTipsEnabled is disabled in settings.json
    if [[ -f ".claude/settings.json" ]]; then
        if ! grep -q '"spinnerTipsEnabled"' ".claude/settings.json" 2>/dev/null; then
            # Add spinnerTipsEnabled at the beginning of JSON object
            sed -i '' 's/^{$/{\n  "spinnerTipsEnabled": false,/' ".claude/settings.json" 2>/dev/null || true
            success "Added spinnerTipsEnabled: false to settings"
        fi
    fi

    # Update version marker
    echo "$VERSION" > .hype/version

    success "Upgraded to $VERSION"
}

# Merge config: add new variables from template, remove deprecated, keep user values
merge_config() {
    local user_config="$1"
    local template="$2"
    local added=()
    local removed=()

    # Build list of valid variable names from template
    local valid_vars=()
    while IFS= read -r line; do
        if [[ "$line" =~ ^([A-Z_][A-Z0-9_]*)= ]]; then
            valid_vars+=("${BASH_REMATCH[1]}")
        fi
    done < "$template"

    # 1. Add new variables (in template but not in user config)
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue

        if [[ "$line" =~ ^([A-Z_][A-Z0-9_]*)= ]]; then
            local var_name="${BASH_REMATCH[1]}"
            if ! grep -q "^${var_name}=" "$user_config" 2>/dev/null; then
                echo "" >> "$user_config"
                echo "# Added in upgrade" >> "$user_config"
                echo "$line" >> "$user_config"
                added+=("$var_name")
            fi
        fi
    done < "$template"

    # 2. Remove deprecated variables (in user config but not in template)
    local tmp_config="${user_config}.tmp"
    > "$tmp_config"
    while IFS= read -r line; do
        if [[ "$line" =~ ^([A-Z_][A-Z0-9_]*)= ]]; then
            local var_name="${BASH_REMATCH[1]}"
            local is_valid=false
            for v in "${valid_vars[@]}"; do
                [[ "$v" == "$var_name" ]] && is_valid=true && break
            done
            if [[ "$is_valid" == "false" ]]; then
                removed+=("$var_name")
                continue  # Skip deprecated variable
            fi
        fi
        echo "$line" >> "$tmp_config"
    done < "$user_config"

    # Replace if we removed anything
    if [[ ${#removed[@]} -gt 0 ]]; then
        mv "$tmp_config" "$user_config"
    else
        rm -f "$tmp_config"
    fi

    # Report changes
    if [[ ${#added[@]} -gt 0 ]]; then
        success "Added config variables: ${added[*]}"
    fi
    if [[ ${#removed[@]} -gt 0 ]]; then
        success "Removed deprecated variables: ${removed[*]}"
    fi
    if [[ ${#added[@]} -eq 0 && ${#removed[@]} -eq 0 ]]; then
        info "Config up to date"
    fi
}

update_gitignore() {
    if [[ ! -f ".gitignore" ]]; then
        return
    fi

    local entries=(".hype/" ".hype-worktrees/" ".claude/" "scripts" "project-scripts/" "logs/" "stats/" "PROJECT_CONTEXT.md" "SPEC.md" "SPEC.draft.md" "SPEC.prev.md" "SPEC_REPORT.prev.md" ".mcp.json")
    local added=()

    for entry in "${entries[@]}"; do
        if ! grep -qxF "$entry" .gitignore 2>/dev/null; then
            echo "$entry" >> .gitignore
            added+=("$entry")
        fi
    done

    # v2.3.17: Sanitize — remove !.hype/ exceptions (agents can add these)
    local sanitized=false
    if grep -q '^!\.hype/' .gitignore 2>/dev/null; then
        sed -i '' '/^!\.hype\//d' .gitignore
        sanitized=true
        warn "Removed !.hype/ exceptions from .gitignore (agents should not override hype rules)"
    fi
    # Normalize .hype/* → .hype/ (glob form misses nested dirs)
    if grep -q '^\.hype/\*$' .gitignore 2>/dev/null; then
        sed -i '' 's/^\.hype\/\*$/.hype\//' .gitignore
        sanitized=true
        warn "Normalized .hype/* → .hype/ in .gitignore"
    fi

    local changed=false
    [[ ${#added[@]} -gt 0 ]] && changed=true
    [[ "$sanitized" == "true" ]] && changed=true

    if [[ "$changed" == "true" ]]; then
        [[ ${#added[@]} -gt 0 ]] && success "Added to .gitignore: ${added[*]}"
    fi
}

update_beads_gitignore() {
    if [[ ! -f ".beads/.gitignore" ]]; then
        return
    fi

    local entries=("export-state/" "dolt-server.lock" "dolt-server.log" "dolt-server.pid" "dolt-server.port" "backup/" ".beads-credential-key")
    local added=()

    for entry in "${entries[@]}"; do
        if ! grep -qxF "$entry" .beads/.gitignore 2>/dev/null; then
            echo "$entry" >> .beads/.gitignore
            added+=("$entry")
        fi
    done

    if [[ ${#added[@]} -gt 0 ]]; then
        success "Added to .beads/.gitignore: ${added[*]}"
    fi
}

# Commit gitignore changes from update_gitignore + update_beads_gitignore
commit_gitignore_changes() {
    git rev-parse --is-inside-work-tree &>/dev/null || return 0

    local files_to_add=()
    git diff --quiet .gitignore 2>/dev/null || files_to_add+=(".gitignore")
    git diff --quiet .beads/.gitignore 2>/dev/null || files_to_add+=(".beads/.gitignore")

    [[ ${#files_to_add[@]} -eq 0 ]] && return 0

    git add "${files_to_add[@]}"
    if git commit -m "chore: update gitignore entries for hype" --no-verify -q 2>/dev/null; then
        success "Committed ${files_to_add[*]}"
        if git remote get-url origin &>/dev/null; then
            git push -q 2>/dev/null && success "Pushed" || true
        fi
    fi
}

run_migrations() {
    local from_version="$1"
    local to_version="$2"

    local migrations_dir="$HYPE_HOME/migrations"
    if [[ ! -d "$migrations_dir" ]]; then
        return
    fi

    # Find and run applicable migrations
    for migration in "$migrations_dir"/*.sh; do
        if [[ ! -f "$migration" ]]; then
            continue
        fi

        local migration_name=$(basename "$migration" .sh)
        # Migration names like: 0.8.0-to-0.9.0.sh
        if [[ "$migration_name" =~ ^([0-9]+\.[0-9]+\.[0-9]+)-to-([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
            local migration_from="${BASH_REMATCH[1]}"
            local migration_to="${BASH_REMATCH[2]}"

            # Check if migration applies
            if version_gte "$from_version" "$migration_from" && version_lt "$from_version" "$migration_to"; then
                info "Running migration: $migration_name"
                source "$migration"
            fi
        fi
    done
}

# Version comparison helpers
version_gte() {
    [[ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" = "$2" ]]
}

version_lt() {
    [[ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" = "$1" ]] && [[ "$1" != "$2" ]]
}

upgrade_all_projects() {
    local force="${1:-false}"

    info "Discovering hype projects..."

    local projects=()
    local search_dirs=("$HOME/Projects" "$HOME/Code" "$HOME/Dev" "$HOME/Zen/Code" "$HOME/work")

    for dir in "${search_dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            while IFS= read -r -d '' project; do
                projects+=("$(dirname "$project")")
            done < <(find "$dir" -maxdepth 3 -type d -name ".hype" -print0 2>/dev/null)
        fi
    done

    if [[ ${#projects[@]} -eq 0 ]]; then
        warn "No hype projects found"
        info "Searched in: ${search_dirs[*]}"
        return
    fi

    success "Found ${#projects[@]} project(s)"
    echo ""

    for project in "${projects[@]}"; do
        echo "━━━ $(basename "$project") ━━━"
        upgrade_project "$project" "$force"
        echo ""
    done

    success "All projects upgraded"
}

# === Delete ===

cmd_delete() {
    if [[ ! -d ".hype" ]]; then
        error "Not a hype project."
        exit 1
    fi

    echo "This will remove hype from the current project."
    echo ""
    echo "Will delete:"
    echo "  - .hype/          (config, lock files)"
    echo "  - .claude/agents     (symlink)"
    echo "  - .claude/commands   (symlink)"
    echo "  - .claude/settings.json"
    echo "  - scripts/           (symlink)"
    echo "  - logs/"
    echo "  - stats/"
    echo ""
    echo "Will NOT touch:"
    echo "  - .beads/            (your project data)"
    echo "  - .git/"
    echo "  - SPEC.md"
    echo "  - Your code"
    echo ""

    read -p "Continue? (y/N) " -n 1 -r
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        info "Cancelled."
        exit 0
    fi

    # Stop HYPE if running
    local lock_file=".hype/hype.lock"
        if [[ -f "$lock_file" ]]; then
        local pid=$(cat "$lock_file" 2>/dev/null || echo "0")
        if kill -0 "$pid" 2>/dev/null; then
            info "Stopping HYPE (PID $pid)..."
            kill "$pid" 2>/dev/null || true
            sleep 1
        fi
    fi

    # Remove hype files
    local deleted=()

    if [[ -d ".hype" ]]; then
        rm -rf .hype
        deleted+=(".hype/")
    fi

    if [[ -L ".claude/agents" ]]; then
        rm -f .claude/agents
        deleted+=(".claude/agents")
    fi

    if [[ -L ".claude/commands" ]]; then
        rm -f .claude/commands
        deleted+=(".claude/commands")
    fi

    if [[ -f ".claude/settings.json" ]]; then
        rm -f .claude/settings.json
        deleted+=(".claude/settings.json")
    fi

    # Remove .claude if empty
    if [[ -d ".claude" ]] && [[ -z "$(ls -A .claude 2>/dev/null)" ]]; then
        rmdir .claude
        deleted+=(".claude/")
    fi

    if [[ -L "scripts" ]]; then
        rm -f scripts
        deleted+=("scripts/")
    fi

    if [[ -d "logs" ]]; then
        rm -rf logs
        deleted+=("logs/")
    fi

    if [[ -d "stats" ]]; then
        rm -rf stats
        deleted+=("stats/")
    fi

    # Clean up PROJECT_CONTEXT.md if exists
    if [[ -f "PROJECT_CONTEXT.md" ]]; then
        rm -f PROJECT_CONTEXT.md
        deleted+=("PROJECT_CONTEXT.md")
    fi

    echo ""
    success "Hype removed from project"
    echo ""
    echo "Deleted:"
    for item in "${deleted[@]}"; do
        echo "  - $item"
    done
}

# === Wipe ===

cmd_wipe() {
    if [[ ! -d ".beads" ]] && [[ ! -d ".hype" ]]; then
        error "Not a hype/beads project."
        exit 1
    fi

    echo "WIPE: Full project cleanup"
    echo ""
    echo "This will:"
    echo "  1. Close ALL beads tasks"
    echo "  2. Run: bd admin cleanup --force (removes .beads/)"
    echo "  3. Run: bd doctor --fix"
    echo "  4. Delete ALL hype files including SPEC.md"
    echo ""
    echo "${RED}WARNING: This is irreversible!${NC}"
    echo ""

    read -p "Type 'WIPE' to confirm: " -r
    echo ""

    if [[ "$REPLY" != "WIPE" ]]; then
        info "Cancelled."
        exit 0
    fi

    # Stop HYPE if running
    local lock_file=".hype/hype.lock"
        if [[ -f "$lock_file" ]]; then
        local pid=$(cat "$lock_file" 2>/dev/null || echo "0")
        if kill -0 "$pid" 2>/dev/null; then
            info "Stopping HYPE (PID $pid)..."
            kill "$pid" 2>/dev/null || true
            sleep 1
        fi
    fi

    # 1. Close all beads tasks
    if [[ -d ".beads" ]] && command -v bd &>/dev/null; then
        info "Closing all beads tasks..."
        local task_ids
        task_ids=$(bd list --json --limit 0 2>/dev/null | jq -r '.[].id' 2>/dev/null || true)
        if [[ -n "$task_ids" ]]; then
            for task_id in $task_ids; do
                bd close "$task_id" --reason="wipe" 2>/dev/null || true
            done
            success "Closed all tasks"
        else
            info "No tasks to close"
        fi

        # 2. bd admin cleanup --force
        info "Running bd admin cleanup --force..."
        bd admin cleanup --force 2>/dev/null || true
        success "Beads cleanup done"

        # 3. bd doctor --fix
        info "Running bd doctor --fix..."
        bd doctor --fix 2>/dev/null || true
        success "Beads doctor done"
    fi

    # 4. Delete all hype files
    local deleted=()

    # Core hype
    [[ -d ".hype" ]] && rm -rf .hype && deleted+=(".hype/")
    [[ -L ".claude/agents" ]] && rm -f .claude/agents && deleted+=(".claude/agents")
    [[ -L ".claude/commands" ]] && rm -f .claude/commands && deleted+=(".claude/commands")
    [[ -f ".claude/settings.json" ]] && rm -f .claude/settings.json && deleted+=(".claude/settings.json")
    [[ -d ".claude" ]] && [[ -z "$(ls -A .claude 2>/dev/null)" ]] && rmdir .claude && deleted+=(".claude/")
    [[ -L "scripts" ]] && rm -f scripts && deleted+=("scripts/")

    # Logs and stats
    [[ -d "logs" ]] && rm -rf logs && deleted+=("logs/")
    [[ -d "stats" ]] && rm -rf stats && deleted+=("stats/")

    # SPEC files
    [[ -f "SPEC.md" ]] && rm -f SPEC.md && deleted+=("SPEC.md")
    [[ -f "SPEC.draft.md" ]] && rm -f SPEC.draft.md && deleted+=("SPEC.draft.md")
    [[ -f "PROJECT_CONTEXT.md" ]] && rm -f PROJECT_CONTEXT.md && deleted+=("PROJECT_CONTEXT.md")

    # MCP config
    [[ -f ".mcp.json" ]] && rm -f .mcp.json && deleted+=(".mcp.json")

    # Clean .gitignore entries
    if [[ -f ".gitignore" ]]; then
        # Remove hype section from .gitignore
        if grep -q "# Hype" .gitignore 2>/dev/null; then
            # Remove from "# Hype" to the next section or end of file
            sed -i.bak '/^# Hype$/,/^# [^C]/{ /^# [^C]/!d; }' .gitignore 2>/dev/null || \
            sed -i '' '/^# Hype$/,/^# [^C]/{ /^# [^C]/!d; }' .gitignore 2>/dev/null || true
            # If that leaves only "# Hype" at end, remove it too
            sed -i.bak '/^# Hype$/d' .gitignore 2>/dev/null || \
            sed -i '' '/^# Hype$/d' .gitignore 2>/dev/null || true
            rm -f .gitignore.bak 2>/dev/null || true
            deleted+=(".gitignore entries")
        fi
    fi

    echo ""
    success "WIPE complete!"
    echo ""
    echo "Deleted:"
    for item in "${deleted[@]}"; do
        echo "  - $item"
    done
    echo ""
    info "Remaining: source code + .git/"
}

# === Reset Phase ===

cmd_reset_phase() {
    local target_phase="${1:-}"

    if [[ ! -d ".hype" ]]; then
        error "Not a hype project."
        exit 1
    fi

    # Valid phases
    local valid_phases="PREPARING PLANNING ANALYZE THINKING CONSULTATION REFLEXING CODING TESTING VALIDATING REPORTING DONE"

    if [[ -z "$target_phase" ]]; then
        echo "Usage: hype reset-phase <PHASE>"
        echo ""
        echo "Available phases:"
        echo "  PREPARING    - Start fresh (Manager)"
        echo "  PLANNING     - Architect creates plan"
        echo "  ANALYZE      - Analysts run"
        echo "  THINKING     - Architect reviews analysts"
        echo "  CODING       - Coders work on tasks"
        echo "  TESTING      - Testers verify product"
        echo "  VALIDATING   - Architect final review"
        echo "  REPORTING    - Version bump + changelog + report"
        echo "  DONE         - Project complete"
        echo ""
        echo "Current phase:"
        if [[ -x "./scripts/detect-phase.sh" ]]; then
            ./scripts/detect-phase.sh | jq -r '.phase // "UNKNOWN"'
        else
            warn "Cannot detect phase (scripts symlink missing)"
        fi
        exit 0
    fi

    target_phase=$(echo "$target_phase" | tr '[:lower:]' '[:upper:]')

    # Validate phase
    if ! echo "$valid_phases" | grep -wq "$target_phase"; then
        error "Unknown phase: $target_phase"
        echo "Valid phases: $valid_phases"
        exit 1
    fi

    local current_phase="" phase_json
    if [[ -x "./scripts/detect-phase.sh" ]]; then
        phase_json=$(./scripts/detect-phase.sh 2>/dev/null || echo '{"phase":"UNKNOWN"}')
        current_phase=$(echo "$phase_json" | jq -r '.phase // "UNKNOWN"' 2>/dev/null || echo "UNKNOWN")
    fi

    info "Forcing phase: $current_phase → $target_phase"

    # Write force-phase file (detect-phase.sh will read and delete it)
    echo "$target_phase" > .hype/force-phase

    # v2.3.9: remove stale tick-cache (will be regenerated on next cycle)
    rm -f .hype/tick-cache.json 2>/dev/null || true

    # Clean up milestones/state for consistency
    # Delete milestones AFTER target phase, create milestones BEFORE target phase
    case "$target_phase" in
        PREPARING)
            # Remove SPEC to trigger Manager
            if [[ -f "SPEC.md" ]]; then
                warn "Moving SPEC.md to SPEC.md.bak"
                mv SPEC.md SPEC.md.bak
            fi
            delete_milestone "milestone:planning-done"
            delete_milestone "milestone:analysts-done"
            delete_milestone "milestone:plan-reviewed"
            delete_milestone "milestone:testing-done"
            delete_milestone "milestone:validating-done"
            delete_milestone "milestone:project-done"
            ;;
        PLANNING)
            # Need: nothing before
            # Delete: all after
            delete_milestone "milestone:planning-done"
            delete_milestone "milestone:analysts-done"
            delete_milestone "milestone:plan-reviewed"
            delete_milestone "milestone:testing-done"
            delete_milestone "milestone:validating-done"
            delete_milestone "milestone:project-done"
            ;;
        ANALYZE)
            # Need: planning-done
            # Delete: analysts-done and after
            ensure_milestone "milestone:planning-done" "Planning complete"
            delete_milestone "milestone:analysts-done"
            delete_milestone "milestone:plan-reviewed"
            delete_milestone "milestone:testing-done"
            delete_milestone "milestone:validating-done"
            delete_milestone "milestone:project-done"
            ;;
        THINKING)
            # Need: planning-done, analysts-done
            # Delete: plan-reviewed and after
            ensure_milestone "milestone:planning-done" "Planning complete"
            ensure_milestone "milestone:analysts-done" "Analysts complete"
            delete_milestone "milestone:plan-reviewed"
            delete_milestone "milestone:testing-done"
            delete_milestone "milestone:validating-done"
            delete_milestone "milestone:project-done"
            ;;
        CODING)
            # Need: planning-done, analysts-done, plan-reviewed
            # Delete: testing-done and after
            ensure_milestone "milestone:planning-done" "Planning complete"
            ensure_milestone "milestone:analysts-done" "Analysts complete"
            ensure_milestone "milestone:plan-reviewed" "Plan reviewed"
            delete_milestone "milestone:testing-done"
            delete_milestone "milestone:validating-done"
            delete_milestone "milestone:project-done"
            ;;
        TESTING)
            # Need: planning-done, analysts-done, plan-reviewed
            # Delete: testing-done and after
            ensure_milestone "milestone:planning-done" "Planning complete"
            ensure_milestone "milestone:analysts-done" "Analysts complete"
            ensure_milestone "milestone:plan-reviewed" "Plan reviewed"
            delete_milestone "milestone:testing-done"
            delete_milestone "milestone:validating-done"
            delete_milestone "milestone:project-done"
            rm -rf .hype/evidence 2>/dev/null || true
            ;;
        VALIDATING)
            # Need: all milestones except validating-done and project-done
            ensure_milestone "milestone:planning-done" "Planning complete"
            ensure_milestone "milestone:analysts-done" "Analysts complete"
            ensure_milestone "milestone:plan-reviewed" "Plan reviewed"
            ensure_milestone "milestone:testing-done" "Testing complete"
            delete_milestone "milestone:validating-done"
            delete_milestone "milestone:project-done"
            ;;
        REPORTING)
            # Need: all milestones except project-done
            ensure_milestone "milestone:planning-done" "Planning complete"
            ensure_milestone "milestone:analysts-done" "Analysts complete"
            ensure_milestone "milestone:plan-reviewed" "Plan reviewed"
            ensure_milestone "milestone:testing-done" "Testing complete"
            ensure_milestone "milestone:validating-done" "Validation passed"
            delete_milestone "milestone:project-done"
            ;;
    esac

    # v2.3.9: Clean legacy bd milestone labels (≤v2.3.8 and agent-created milestones)
    # Without this, detect-phase.sh fallback finds old bd milestones that should be deleted
    local all_bd_tasks
    all_bd_tasks=$(bd_safe list --all --json --limit 0 2>/dev/null || echo "[]")
    for milestone_label in "milestone:planning-done" "milestone:analysts-done" "milestone:plan-reviewed" "milestone:testing-done" "milestone:validating-done" "milestone:project-done"; do
        # Only clean if this milestone was DELETED (not if it was ensured)
        if ! has_milestone "$milestone_label"; then
            local legacy_ids
            legacy_ids=$(echo "$all_bd_tasks" | jq -r ".[] | select(.labels[]? == \"$milestone_label\") | .id" 2>/dev/null || true)
            for mid in $legacy_ids; do
                bd_safe update "$mid" --remove-label="$milestone_label" >/dev/null 2>&1 || true
            done
        fi
    done

    success "Phase set to $target_phase"
    echo ""
    info "Run 'hype start' to continue"
}

# === Stop ===

cmd_stop() {
    if [[ ! -d ".hype" ]]; then
        error "Not a hype project."
        exit 1
    fi

    local lock_file=".hype/hype.lock"

    if [[ ! -f "$lock_file" ]]; then
        info "HYPE not running (no lock file)"
        exit 0
    fi

    local pid=$(cat "$lock_file" 2>/dev/null || echo "0")

    if ! kill -0 "$pid" 2>/dev/null; then
        info "HYPE not running (stale lock file, removing)"
        rm -f "$lock_file"
        exit 0
    fi

    # Collect full process tree BEFORE killing HYPE
    # (after SIGTERM, children become orphans and we lose the tree)
    local descendants
    descendants=$(collect_descendants "$pid")

    info "Stopping HYPE (PID $pid)..."
    kill -TERM "$pid" 2>/dev/null || true

    # Wait for graceful shutdown (max 5 seconds)
    local waited=0
    while kill -0 "$pid" 2>/dev/null && [[ $waited -lt 5 ]]; do
        sleep 1
        ((waited++))
    done

    if kill -0 "$pid" 2>/dev/null; then
        warn "HYPE didn't stop gracefully, sending SIGKILL..."
        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$lock_file"
    success "HYPE stopped"

    # Kill only descendant processes of this HYPE instance (not system-wide)
    if [[ -n "$descendants" ]]; then
        info "Stopping agent processes..."
        for dpid in $descendants; do
            kill -9 "$dpid" 2>/dev/null || true
        done
        success "Agent processes stopped"
    fi
}

# Recursively collect all descendant PIDs of a process
collect_descendants() {
    local parent=$1
    local children
    children=$(pgrep -P "$parent" 2>/dev/null) || return 0
    for child in $children; do
        echo "$child"
        collect_descendants "$child"
    done
}

# === Clear ===

cmd_clear() {
    if [[ ! -d ".hype" ]]; then
        error "Not a hype project."
        exit 1
    fi

    echo "This will clean up the project:"
    echo ""
    echo "  - Close and delete beads tasks"
    echo "  - Delete all logs"
    echo "  - Clear beads tasks"
    echo "  - Delete milestones"
    echo "  - Clean worktrees"
    echo "  - Archive SPEC.md → SPEC.prev.md"
    echo ""

    read -p "Continue? (Y/n) " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Nn]$ ]]; then
        info "Cancelled."
        exit 0
    fi

    # Use cleanup_iteration from common.sh
    cleanup_iteration "logs" "."

    success "Cleanup complete! Ready for new iteration."
    echo ""
    info "Run 'hype start' to begin new iteration"
}

# === Help ===

cmd_help() {
    print_hype_logo
    echo -e "${HYPE_H}H${HYPE_Y}Y${HYPE_P}P${HYPE_E}E${NC} $VERSION — multi-agent development system"
    echo ""
    echo "Usage: hype <command>"
    echo ""
    echo "Commands:"
    echo "  init         Initialize project and start HYPE"
    echo "  start        Start HYPE (project must be initialized)"
    echo "  stop         Stop HYPE and all agent processes"
    echo "  status       Show project and HYPE status"
    echo "  doctor       Diagnose HYPE problems (creates doctor-log)"
    echo "               --report   Non-interactive mode"
    echo "  clear        Clean up after iteration (logs, tasks, SPEC → SPEC.prev)"
    echo "  update       Update hype and check/upgrade dependencies"
    echo "               --no-deps  Skip dependency updates"
    echo "  upgrade      Upgrade current project to latest hype version"
    echo "               --all    Upgrade all discovered projects"
    echo "               --force  Force upgrade even if versions match"
    echo "  delete       Remove hype from project (keeps .beads, code, SPEC)"
    echo "  wipe         Full cleanup: close tasks, remove .beads/, all hype files"
    echo "  reset-phase  Reset to earlier phase (PLANNING, ANALYZE, THINKING, TESTING, REPORTING)"
    echo ""
    echo "Home: $HYPE_HOME"
}

# === Main ===

case "${1:-}" in
    init)   cmd_init ;;
    start)  cmd_start ;;
    stop)   cmd_stop ;;
    status) cmd_status ;;
    clear)  cmd_clear ;;
    doctor) shift; exec "$HYPE_HOME/core/scripts/doctor.sh" "$@" ;;
    update) shift; cmd_update "$@" ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    delete) cmd_delete ;;
    wipe)   cmd_wipe ;;
    reset-phase) shift; cmd_reset_phase "$@" ;;
    -h|--help|help|"") cmd_help ;;
    *)
        error "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
